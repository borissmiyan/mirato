{
  "name": "mirato",
  "private": true,
  "version": "2.3.0",
  "description": "Mirato — Premium Bible presentation and worship software",
  "author": "Boris Smiyan <borissmiyan@gmail.com>",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "tsc && vite build",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:mac-modern": "node scripts/build-mac.js modern",
    "build:mac-legacy": "node scripts/build-mac.js legacy",
    "build:mac-all": "npm run build:mac-modern && npm run build:mac-legacy",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:all": "tsc && vite build && electron-builder -mwl",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "check": "tsc --noEmit && eslint src && vitest run",
    "check:types": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "check:electron": "tsc --project tsconfig.electron.json --noEmit",
    "check:circular": "node scripts/verify-no-circular.mjs",
    "check:hygiene": "node scripts/verify-resource-hygiene.mjs",
    "check:esm": "node scripts/verify-esm-and-path-hygiene.mjs",
    "check:smoke": "node scripts/verify-electron-smoke.mjs",
    "check:memo": "node scripts/verify-memoization.mjs",
    "check:design": "node scripts/verify-design-system.mjs",
    "check:security:antipatterns": "node scripts/verify-security-antipatterns.mjs",
    "check:dead-code": "knip",
    "check:schema-drift": "node scripts/verify-schema-drift.mjs",
    "check:debug-leftovers": "node scripts/verify-no-debug-leftovers.mjs",
    "check:large-files": "node scripts/verify-no-large-files.mjs",
    "check:component-budget": "node scripts/verify-component-budget.mjs",
    "test:flaky": "node scripts/test-flaky.mjs",
    "test:mutate": "stryker run",
    "check:security:snyk": "snyk test",
    "verify:remote": "node scripts/verify-remote-ci.mjs",
    "push:verify": "node scripts/verify-remote-ci.mjs --push"
  },
  "build": {
    "appId": "com.mirato.app",
    "productName": "Mirato",
    "icon": "build/icon.png",
    "directories": {
      "output": "release/modern"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/vite",
      "!node_modules/esbuild",
      "!node_modules/@esbuild"
    ],
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSMinimumSystemVersion": "12.0.0"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 120,
          "type": "file",
          "path": "build/Команда_для_Терминала.txt"
        }
      ]
    },
    "extraResources": [
      {
        "from": "bundled-templates/",
        "to": "bundled-templates/",
        "filter": [
          "**/*.mrtmp",
          "**/*.ektmp"
        ]
      },
      {
        "from": "bundled-hymnals/",
        "to": "bundled-hymnals/",
        "filter": [
          "**/*.mrtp",
          "**/*.ektp"
        ]
      }
    ],
    "win": {
      "artifactName": "Mirato-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Education",
      "maintainer": "Boris Smiyan <borissmiyan@gmail.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "electron/installer.nsh"
    },
    "artifactName": "Mirato-${version}-macOS12+-${arch}.${ext}",
    "electronLanguages": [
      "en",
      "ru",
      "de",
      "uk"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-virtual": "^3.13.14",
    "dompurify": "^3.2.4",
    "@fontsource/alice": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/comfortaa": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/crimson-pro": "^5.2.8",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/fira-sans": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lobster": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/pt-sans": "^5.2.8",
    "@fontsource/pt-serif": "^5.2.8",
    "@fontsource/raleway": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@fontsource/ubuntu": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "express": "^5.2.1",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jotai": "^2.17.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.5.6",
    "react-router-dom": "^7.13.0",
    "react-scan": "^0.5.3",
    "react-world-flags": "^1.6.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.4.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  }
}